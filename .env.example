# Canonical production URL used for metadata, sitemap, and robots.txt.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Portal access. Change both values before publishing a production deployment.
# Default access code when unset: LEGACY-2026
LEGACY_ACCESS_CODE=LEGACY-2026
AUTH_SECRET=replace-with-a-long-random-string

# Login notifications are sent here. Default: deayusts@gmail.com
LEGACY_OWNER_EMAIL=deayusts@gmail.com

# Preferred channel: Gmail SMTP. Sends both the owner history and a login
# confirmation to the visitor, with "LEGACY AI" as the sender name.
# Requires 2-Step Verification and a Google App Password (16 characters).
GMAIL_USER=deayusts@gmail.com
GMAIL_APP_PASSWORD=

# Alternative channel: Resend. Without a verified sending domain, Resend only
# delivers to the account owner. A verified domain can also reach visitors.
RESEND_API_KEY=
RESEND_FROM=LEGACY AI <onboarding@resend.dev>

# If Gmail and Resend are both empty, the app falls back to ShipMyForm, which
# sends only to the owner after the one-time activation email is confirmed.
