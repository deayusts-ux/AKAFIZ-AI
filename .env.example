# Canonical production URL used for metadata, sitemap, and robots.txt.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Portal access. Change both values before publishing a production deployment.
# Default access code when unset: LEGACY-2026
LEGACY_ACCESS_CODE=LEGACY-2026
AUTH_SECRET=replace-with-a-long-random-string

# Login notifications are sent here. Default: deayusts@gmail.com
LEGACY_OWNER_EMAIL=deayusts@gmail.com

# Optional email delivery via Resend. Without a key, the app falls back to
# ShipMyForm (the first submission sends an activation email to the owner).
RESEND_API_KEY=
RESEND_FROM=LEGACY AI <onboarding@resend.dev>
